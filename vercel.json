{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "website",
  "routes": [
    {
      "src": "/journal\\.html",
      "dest": "/journal.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer"
      }
    },
    {
      "src": "/journal-8891f572595846a3/?",
      "dest": "/journal.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer"
      }
    },
    {
      "src": "/api/machine/(.*)",
      "dest": "/api/machine?path=$1"
    },
    {
      "src": "/project-detail\\.html",
      "has": [
        {
          "type": "query",
          "key": "project",
          "value": "a-machine-for-misunderstanding"
        }
      ],
      "dest": "/projects/machine/live/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
