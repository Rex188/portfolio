{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "website",
  "routes": [
    {
      "src": "/api/machine/(.*)",
      "dest": "/api/machine?path=$1"
    },
    {
      "src": "/project-detail\\.html",
      "has": [
        {
          "type": "query",
          "key": "project",
          "value": "a-machine-for-misunderstanding"
        }
      ],
      "dest": "/projects/machine/live/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
